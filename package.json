    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.12",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0",
    "tsd": "^0.33.0"
  },
  "nyc": {
    "check-coverage": true,
